<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/background_wave"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="Pertanyaan"
        android:textSize="20sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/pertanyaan_textview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/picture_4"
        android:hint="Pertanyaan"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:paddingTop="10dp"
        android:paddingBottom="25dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="Pilihan"
        android:textSize="20sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/pilihan_textview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/picture_4"
        android:hint="pilihan"
        android:padding="40dp"
        android:textColor="@color/black"
        android:textSize="14sp" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:scaleType="fitXY"
        app:srcCompat="@drawable/picture_5" />

</LinearLayout>
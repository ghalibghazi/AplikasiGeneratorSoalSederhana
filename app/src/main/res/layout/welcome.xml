<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/background_wave">


    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/welcomeLoginButton"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/button_solid_1"
        android:text="Login"
        android:fontFamily="@font/baloo"
        android:textSize="24dp"
        android:gravity="center"
        android:elevation="5dp"
        app:layout_constraintBottom_toTopOf="@id/welcomeRegisterButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/welcomeTitleText"
        tools:ignore="VisualLintOverlap" />


    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/welcomeRegisterButton"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:background="@drawable/button_solid_1"
        android:fontFamily="@font/baloo"
        android:gravity="center"
        android:text="Register"
        android:textSize="24sp"
        android:elevation="5dp"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/welcomeLoginButton" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/welcomeTitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/baloo"
        android:text="Aplikasi Generator Soal"
        android:textColor="@color/black"
        android:textSize="34sp"
        android:textStyle="bold"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/welcomeImage" />

    <ImageView
        android:id="@+id/welcomeImage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        android:contentDescription="TODO"
        app:layout_constraintBottom_toTopOf="@id/welcomeTitleText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:src="@drawable/rectangle_27_r"
        tools:ignore="ImageContrastCheck" />

    <ImageView
        android:id="@+id/welcomeBackgroundImage1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="TODO"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:src="@drawable/welcome_3"
        tools:ignore="ImageContrastCheck" />

    <ImageView
        android:id="@+id/welcomeBackgroundImage2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/welcome_2"
        tools:ignore="ImageContrastCheck" />

    <ImageView
        android:id="@+id/welcomeBackgroundImage3"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/welcome_1"
        tools:ignore="ImageContrastCheck" />

</androidx.constraintlayout.widget.ConstraintLayout>
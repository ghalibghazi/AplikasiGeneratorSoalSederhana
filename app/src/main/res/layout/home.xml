<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <ImageView
        android:id="@+id/homeBackgroundImage1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:src="@drawable/picture_1" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/homeBackgroundImage2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="258dp"
        android:layout_marginBottom="-20dp"
        android:scaleType="centerCrop"
        android:src="@drawable/background_wave"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/homeBackgroundImage1"
        app:shapeAppearanceOverlay="@style/RoundedImageViewStyle" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/homeBackgroundImage3"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:scaleType="centerCrop"
        android:src="@color/theme_color_2"
        android:layout_marginEnd="10dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="-130dp"
        android:elevation="5dp"
        app:layout_constraintTop_toTopOf="@id/homeBackgroundImage2"
        app:shapeAppearanceOverlay="@style/RoundedImageViewStyle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/homeProfileImage"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginEnd="15dp"
        android:elevation="5dp"
        app:layout_constraintEnd_toEndOf="@id/homeBackgroundImage3"
        app:layout_constraintTop_toTopOf="@id/homeBackgroundImage3"
        app:layout_constraintBottom_toBottomOf="@id/homeBackgroundImage3"
        android:src="@drawable/profile_picture_1" />

    <LinearLayout
        android:id="@+id/HomeProfileLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:elevation="5dp"
        app:layout_constraintBottom_toBottomOf="@id/homeProfileImage"
        app:layout_constraintEnd_toStartOf="@id/homeProfileImage"
        app:layout_constraintTop_toTopOf="@id/homeProfileImage">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/textView"
            android:layout_width="250dp"
            android:layout_height="35dp"
            android:fontFamily="@font/comic_neue_bold"
            android:gravity="center"
            android:text="✋Hi, Budi Budiman"
            android:textAlignment="viewEnd"
            android:textColor="@color/black"
            android:textSize="18sp"
            tools:ignore="RtlCompat" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/textView2"
            android:layout_width="250dp"
            android:layout_height="35dp"
            android:fontFamily="@font/comic_neue_bold"
            android:text="SD Muhammadiyah Teacher"
            android:textAlignment="viewEnd"
            android:textColor="@color/black"
            android:textSize="18sp"
            tools:gravity="center" />
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/homeButton1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:background="@drawable/big_button_1"
        android:fontFamily="@font/baloo_da"
        android:gravity="center|left"
        android:paddingStart="10dp"
        android:text="Buat Tulisan Baru"
        android:textAllCaps="false"
        android:textColor="@color/black"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/homeProfileImage" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/homeButton2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/big_button_2"
        android:fontFamily="@font/baloo_da"
        android:paddingStart="10dp"
        android:text="Daftar Tulisan"
        android:textAllCaps="false"
        android:textColor="@color/black"
        android:textSize="24sp"
        android:gravity="center|left"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/homeButton1" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/homeButton3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/big_button_3"
        android:fontFamily="@font/baloo_da"
        android:paddingStart="10dp"
        android:text="Pengaturan"
        android:gravity="center|left"
        android:textAllCaps="false"
        android:textColor="@color/black"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/homeButton2" />

    <TextView
        android:id="@+id/copyright"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Copyright © 2025 Gusti Ghalib Ghazi"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>